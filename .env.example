# ==== BIZNES / LOYIHA ====
BUSINESS_NAME="AFU AI Assistant"
BUSINESS_SLUG="afu_ai_assistant"
DJANGO_SECRET_KEY="django-insecure-CHANGE-ME"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"

# ==== POSTGRESQL ====
POSTGRES_DB="afu_ai_assistant"
POSTGRES_USER="afu_admin"
POSTGRES_PASSWORD="change_me"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# ==== TELEGRAM (obuna ogohlantirishi uchun bot tokeni) ====
TELEGRAM_BOT_TOKEN="0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==== VERTEX AI (Google Cloud) - embedding uchun ====
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
VERTEX_EMBEDDING_MODEL="gemini-embedding-001"

# ==== LLM javob generatsiyasi (Vertex AI Gemini, GCP hisobingiz orqali) ====
# Standart model — kerak bo'lsa Super Admin panelidan har bir loyiha uchun o'zgartiriladi.
DEFAULT_LLM_MODEL="gemini-2.5-flash"

# ==== SUPER ADMIN bilan bog'lanish uchun (statistika hisobot) ====
INTERNAL_API_TOKEN="ichki-maxfiy-token-CHANGE-ME"

# ==== TELETHON (Telegram AKKAUNT sifatida ulanish, ixtiyoriy) ====
# api_id / api_hash: https://my.telegram.org/apps dan olinadi.
# Akkauntning o'zi endi admin panel > Super Admin > "Telegram akkaunt" bo'limidan
# telefon+kod orqali ulanadi (bu yerga qo'shimcha narsa yozish shart emas).
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# ==== SUPER ADMIN ====
# Obuna tugashiga 5 kun qolganda shu Telegram ID'ga ogohlantirish yuboriladi
SUPERADMIN_TELEGRAM_ID=""
